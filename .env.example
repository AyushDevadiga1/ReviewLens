# Copy to .env and fill in values
# Never commit .env to git

# Database — host port is 5433 (compose maps 5433→5432); the password
# must match POSTGRES_PASSWORD or the API cannot authenticate.
DATABASE_URL=postgresql://reviewlens:password@localhost:5433/reviewlens
POSTGRES_USER=reviewlens
POSTGRES_PASSWORD=password
POSTGRES_DB=reviewlens

# Log every SQL statement + bound parameters. Dev only — logs review text.
SQL_ECHO=False

# API Security
API_KEY_SECRET=your-secret-key-here-change-this
# Swagger/ReDoc/schema — OFF unless true (production default)
ENABLE_DOCS=true

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# Model paths
FAKE_DETECTOR_MODEL_DIR=ml/fake_review/model
ABSA_CHECKPOINT=multilingual

# Scraping
MAX_SCRAPE_PAGES=5
SCRAPE_DELAY_SECONDS=2