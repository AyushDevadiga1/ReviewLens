# Dockerfile.frontend — ReviewLens Streamlit dashboard
# Separate from the API image so each service stays lean.

FROM python:3.11-slim

WORKDIR /app

# Pages import `from ml.absa.aspects import ASPECTS` — /app must be importable
ENV PYTHONPATH=/app

# Streamlit only needs a subset of the full requirements
RUN pip install --no-cache-dir \
    streamlit==1.32.0 \
    plotly==5.18.0 \
    pandas==2.1.3 \
    requests==2.31.0 \
    python-dotenv==1.0.0

COPY frontend/ ./frontend/
COPY ml/absa/aspects.py ./ml/absa/aspects.py

# Theme lives with the app code, but Streamlit only reads $CWD/.streamlit
COPY frontend/.streamlit/config.toml /app/.streamlit/config.toml

EXPOSE 8501

CMD ["streamlit", "run", "frontend/Overview.py", "--server.port=8501", "--server.address=0.0.0.0"]
